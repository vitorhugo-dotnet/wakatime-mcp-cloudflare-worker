{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wakatime-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
